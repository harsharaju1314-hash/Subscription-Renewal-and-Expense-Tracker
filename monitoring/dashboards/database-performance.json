  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "MySQL Database Query Latency (P50, P95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(database_query_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P50 Query Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(database_query_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Query Latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Redis Cache Hit Ratio (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(rate(redis_cache_hits_total[1m])) / (sum(rate(redis_cache_hits_total[1m])) + sum(rate(redis_cache_misses_total[1m])))) * 100",
          "legendFormat": "Cache Hit %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Redis Cache Throughput (Hits vs Misses)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(redis_cache_hits_total[1m]))",
          "legendFormat": "Cache Hits/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(redis_cache_misses_total[1m]))",
          "legendFormat": "Cache Misses/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Database Connection Pool Usage",
      "type": "stat",
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected or vector(8)",
          "legendFormat": "Active Connections",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none" }
      }
    }
  ],
