# ==============================================================================
# AI-Powered Subscription & Expense Analytics Platform - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production, testing)
ENVIRONMENT=development
DEBUG=True

# Backend Service (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-super-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL for Production / Docker, SQLite supported for Local)
# For MySQL: mysql+pymysql://sub_user:sub_password@localhost:3306/subscription_db
# For Local Quickstart: sqlite:///./subscription_tracker.db
DATABASE_URL=sqlite:///./subscription_tracker.db
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=subscription_db
MYSQL_USER=sub_user
MYSQL_PASSWORD=sub_password
MYSQL_PORT=3306

# Redis Caching Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# AI Inference Service (Flask + LangChain + FAISS)
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5001
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_TIMEOUT=15.0

# OpenAI API (Optional in local development; mock/heuristic engine handles offline queries)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (FAISS index storage directory)
FAISS_INDEX_DIR=./data/faiss_index

# Frontend Configuration
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8000/api
